<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    tools:context=".healthConnect.activity.HealthConnectActivity">

    <Button
        android:id="@+id/checkHealthConnectAvailabilityStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="84dp"
        android:text="Check Health Connect Availability Status" />

    <Button
        android:id="@+id/initialHealthConnect"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        tools:text="Not Supported/Install Health Connect/ Connected/ Not Connected" />

    <Button
        android:id="@+id/openHealthConnectApp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Open Health Connect App" />

    <Button
        android:id="@+id/removeHealthConnectPermission"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Remove Health Connect Permission" />

</LinearLayout>
